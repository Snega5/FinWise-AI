# Copy this file to ".env" and fill in your own key. Never share or commit ".env".
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model. If it is retired, pick a current one from the Groq console's model list.
GROQ_MODEL=openai/gpt-oss-120b

# Local embedding model (downloaded once, about 90 MB, then runs offline).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
